# Copy to .env.local for local development. Never commit the real key.
#
# On Vercel this lives in Settings → Environment Variables instead, so the key
# only ever exists on the server. The browser bundle never receives it — note
# there is no VITE_ prefix here, which is what keeps it out of the client build.
#
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Free-tier quotas differ per model and Google retires older ones, so
# the model is swappable without a code change. Defaults to gemini-2.5-flash.
# Other current options: gemini-2.5-flash-lite, gemini-3.5-flash-lite, gemini-3.6-flash
# GEMINI_MODEL=gemini-2.5-flash-lite
